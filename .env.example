YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 관리자 계정 이메일 (Google 로그인 시 이 이메일이면 관리자 권한 부여)
ADMIN_EMAIL=naebon1@gmail.com

# 세션 암호화 키
SESSION_SECRET=your_session_secret_here

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# 로컬: http://localhost:5151/auth/google/callback
# Vercel: https://your-app.vercel.app/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5151/auth/google/callback
